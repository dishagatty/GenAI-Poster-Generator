# ==========================================
# PromptPoster AI - Configuration Template
# ==========================================

# Hugging Face User Access Token (Free tier or Pro)
# Get your token from: https://huggingface.co/settings/tokens
# Ensure the token has "Read" or "Inference Providers" access permissions.
HF_TOKEN=your_hugging_face_token_here

# Optional: Default AI Model (e.g. black-forest-labs/FLUX.1-schnell, stabilityai/stable-diffusion-xl-base-1.0)
HF_MODEL=black-forest-labs/FLUX.1-schnell

# Optional: Inference Provider ("auto", "hf-inference", "together", "fal-ai", "replicate")
HF_PROVIDER=hf-inference
